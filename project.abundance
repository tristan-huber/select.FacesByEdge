        }
      ],
      "interpreterVersion": 1,
      "code": "// select.adjascentFaces\nfunction run(a1: Assembly) {\n  return a1.onLeafs((leaf) => {\n    if (!leaf.is3D()) {\n      return leaf;\n    }\n    if (leaf.selection == undefined || leaf.selection.edges == undefined) {\n      leaf.selection = { edges: [], faces: [], part: false }\n      return leaf;\n    }\n    const edgeSelectionIndexes = leaf.selection.edges;\n    const shapeEdges = leaf.geometry.edges;\n    const edgeIndex = (edge) => {\n      return shapeEdges.findIndex((e) => e.isSame(edge))\n    }\n    const selectedFaceIndexes = new Set<number>()\n    leaf.geometry.faces.forEach((face, index) => {\n      const faceEdges = face.edges;\n      if (faceEdges.some((e) => edgeSelectionIndexes.includes(edgeIndex(e)))) {\n        selectedFaceIndexes.add(index)\n      }\n    })\n    leaf.selection.faces = [...selectedFaceIndexes]\n    return leaf;\n  })?.skipDisjointPostprocess()\n}",
      "compiledCode": "\"use strict\";\n// select.adjascentFaces\nfunction run(a1) {\n    return a1.onLeafs((leaf) => {\n        if (!leaf.is3D()) {\n            return leaf;\n        }\n        if (leaf.selection == undefined || leaf.selection.edges == undefined) {\n            leaf.selection = { edges: [], faces: [], part: false };\n            return leaf;\n        }\n        const edgeSelectionIndexes = leaf.selection.edges;\n        const shapeEdges = leaf.geometry.edges;\n        const edgeIndex = (edge) => {\n            return shapeEdges.findIndex((e) => e.isSame(edge));\n        };\n        const selectedFaceIndexes = new Set();\n        leaf.geometry.faces.forEach((face, index) => {\n            const faceEdges = face.edges;\n            if (faceEdges.some((e) => edgeSelectionIndexes.includes(edgeIndex(e)))) {\n                selectedFaceIndexes.add(index);\n            }\n        });\n        leaf.selection.faces = [...selectedFaceIndexes];\n        return leaf;\n    })?.skipDisjointPostprocess();\n}\n"
    },
